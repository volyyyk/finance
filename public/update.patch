+            setCashbackData={handleUpdateCashback}
+            cbDict={cbDict}
+            setCbDict={handleUpdateCbDict}
+          />
+        )}
+
+        {/* 3. Investments Tab */}
+        {activeTab === 'invest' && (
+          <InvestmentsSection
+            products={products}
+            onUpdateProduct={handleUpdateSingleProduct}
+          />
+        )}
