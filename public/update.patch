+  const handleSaveProductModal = (product: Product) => {
+    if (editingProduct) {
+      const next = products.map(p => p.id === product.id ? product : p);
+      handleUpdateProducts(next);
+    } else {
+      const next = [...products, product];
+      handleUpdateProducts(next);
+    }
+  };
